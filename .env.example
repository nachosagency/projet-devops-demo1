# Modele de configuration. Copier en .env et remplir. Le .env n'est JAMAIS
# versionne ni mis dans une image : il reste sur la machine qui en a besoin.

# --- Base de donnees ---
DB_USER=taskmanager
DB_PASSWORD=change-moi
DB_ROOT_PASSWORD=change-moi-aussi

# --- Ports cote machine ---
FRONT_PORT=8080
API_PORT=3000
DB_PORT=3307

# --- Serveur uniquement (compose de prod) ---
# ENVIRONNEMENT=staging
# IMAGE_PREFIX=ghcr.io/mon-compte/mon-depot
